{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/shadow-decision-receipt.schema.json",
  "title": "ATG Shadow Decision Receipt",
  "description": "An observational, non-authorising receipt which is structurally distinct from a GatePass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "receiptType", "receiptId", "mode", "observational", "nonAuthorising", "wouldOutcome", "reasonCodes", "ruleIdentifiers", "passportReference", "policyReference", "exactActionDigest", "riskAssessment", "evidenceDecay", "evaluatedAt", "gatePassIssued", "executionAuthority", "actionExecuted", "originalActionImmutable", "resubmissionRequiresNewEvaluation", "buyerPolicyApprovalProven", "localOnly", "syntheticOnly", "productionReady", "receiptDigest"],
  "properties": {
    "receiptVersion": { "const": "atg.shadow-decision-receipt.local.v1" },
    "receiptType": { "const": "shadow_decision" },
    "receiptId": { "type": "string", "pattern": "^shadow:[a-f0-9]+$" },
    "mode": { "const": "shadow" },
    "observational": { "const": true },
    "nonAuthorising": { "const": true },
    "wouldOutcome": { "enum": ["ACCEPT", "REFER", "REJECT"] },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "ruleIdentifiers": { "type": "array", "items": { "type": "string" } },
    "passportReference": { "type": "object" },
    "policyReference": { "type": "object" },
    "exactActionDigest": { "type": ["string", "null"] },
    "riskAssessment": { "type": ["object", "null"] },
    "evidenceDecay": { "type": ["object", "null"] },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "gatePassIssued": { "const": false },
    "executionAuthority": { "const": false },
    "actionExecuted": { "const": false },
    "originalActionImmutable": { "const": true },
    "resubmissionRequiresNewEvaluation": { "const": true },
    "buyerPolicyApprovalProven": { "const": false },
    "localOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "productionReady": { "const": false },
    "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
