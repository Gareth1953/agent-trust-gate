{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/assurance-coverage-map.schema.json",
  "title": "ATG Assurance Coverage Map",
  "type": "object",
  "required": ["mapVersion", "runId", "entries", "totals", "mapDigest", "syntheticEvidenceOnly"],
  "properties": {
    "mapVersion": { "const": "atg.assurance-coverage-map.local.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "minItems": 20, "items": { "type": "object", "required": ["controlId", "controlObjective", "concern", "implementationComponent", "applicableCases", "acceptanceTestReference", "status", "explanation", "knownLimitation", "verificationMethod", "entryDigest"] } },
    "totals": { "type": "object", "required": ["DEMONSTRATED", "PARTIALLY_DEMONSTRATED", "NOT_DEMONSTRATED", "OUT_OF_SCOPE"] },
    "mapDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "syntheticEvidenceOnly": { "const": true }
  }
}
