{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/mcp-exact-action-result-v2.schema.json",
  "title": "ATG MCP Business-Policy Exact-Action Result v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["resultVersion", "gatewayVersion", "mode", "outcome", "wouldOutcome", "reasonCodes", "ruleIdentifiers", "passport", "businessPolicy", "exactActionDigest", "riskAssessment", "evidenceDecay", "policyDecisionReceipt", "shadowDecisionReceipt", "gatePass", "gatePassIssued", "supportedOutcomes", "deferredOutcomes", "executionReceipt", "executionAvailable", "actionExecuted", "enforcementStateMutated", "localOnly", "syntheticOnly", "observational", "authorising", "productionReady", "commercialWisdomAssessed"],
  "properties": {
    "resultVersion": { "const": "atg.mcp-exact-action-result.local.v2" },
    "gatewayVersion": { "const": "atg.mcp-exact-action-gateway.local.v1" },
    "mode": { "enum": ["enforced", "shadow"] },
    "outcome": { "enum": ["ACCEPT", "REFER", "REJECT", "SHADOW"] },
    "wouldOutcome": { "enum": ["ACCEPT", "REFER", "REJECT", null] },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "ruleIdentifiers": { "type": "array", "items": { "type": "string" } },
    "passport": { "type": "object" },
    "businessPolicy": { "type": "object" },
    "exactActionDigest": { "type": ["string", "null"] },
    "riskAssessment": { "type": ["object", "null"] },
    "evidenceDecay": { "type": ["object", "null"] },
    "policyDecisionReceipt": { "type": ["object", "null"] },
    "shadowDecisionReceipt": { "type": ["object", "null"] },
    "gatePass": { "type": ["object", "null"] },
    "gatePassIssued": { "type": "boolean" },
    "supportedOutcomes": { "type": "array" },
    "deferredOutcomes": { "type": "array" },
    "executionReceipt": { "type": "null" },
    "executionAvailable": { "const": false },
    "actionExecuted": { "const": false },
    "enforcementStateMutated": { "type": "boolean" },
    "localOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "observational": { "type": "boolean" },
    "authorising": { "type": "boolean" },
    "productionReady": { "const": false },
    "commercialWisdomAssessed": { "const": false }
  }
}
