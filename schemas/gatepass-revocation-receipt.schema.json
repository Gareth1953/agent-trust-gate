{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/gatepass-revocation-receipt.schema.json",
  "title": "ATG GatePass Revocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "receiptId", "gatePassId", "lifecycleId", "actionDigest", "reason", "actorReference", "authorityEvidenceDigest", "revokedAt", "idempotentReplay", "reversedExternalAction", "localOnly", "syntheticOnly", "receiptDigest"],
  "properties": {
    "receiptVersion": { "const": "atg.gatepass-revocation-receipt.local.v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "gatePassId": { "type": "string", "minLength": 1 },
    "lifecycleId": { "type": "string", "minLength": 1 },
    "actionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "actorReference": { "type": "string", "minLength": 1 },
    "authorityEvidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "idempotentReplay": { "type": "boolean" },
    "reversedExternalAction": { "const": false },
    "localOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
