{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/mcp-exact-action-result.schema.json",
  "title": "ATG MCP Exact-Action Result",
  "description": "Additive MCP orchestration result. P3-M158 implements only ACCEPT and REJECT and never executes an action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultVersion", "gatewayVersion", "outcome", "reasonCodes", "passport", "exactActionDigest", "policyDecisionReceipt", "gatePass", "gatePassIssued", "supportedOutcomes", "deferredOutcomes", "executionReceipt", "executionAvailable", "actionExecuted", "localOnly", "productionReady", "commercialWisdomAssessed"],
  "properties": {
    "resultVersion": { "const": "atg.mcp-exact-action-result.local.v1" },
    "gatewayVersion": { "const": "atg.mcp-exact-action-gateway.local.v1" },
    "outcome": { "enum": ["ACCEPT", "REJECT"] },
    "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "passport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passportId", "passportVersion", "passportDigest", "verified"],
      "properties": {
        "passportId": { "type": "string", "minLength": 1 },
        "passportVersion": { "type": "string", "minLength": 1 },
        "passportDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "verified": { "type": "boolean" }
      }
    },
    "exactActionDigest": { "oneOf": [{ "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, { "type": "null" }] },
    "policyDecisionReceipt": { "oneOf": [{ "$ref": "policy-decision-receipt.schema.json" }, { "type": "null" }] },
    "gatePass": { "oneOf": [{ "$ref": "exact-action-gatepass.schema.json" }, { "type": "null" }] },
    "gatePassIssued": { "type": "boolean" },
    "supportedOutcomes": { "const": ["ACCEPT", "REJECT"] },
    "deferredOutcomes": { "const": ["REFER", "REVOKE"] },
    "executionReceipt": { "type": "null" },
    "executionAvailable": { "const": false },
    "actionExecuted": { "const": false },
    "localOnly": { "const": true },
    "productionReady": { "const": false },
    "commercialWisdomAssessed": { "const": false }
  }
}
