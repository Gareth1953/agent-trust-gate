{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/business-policy-contract.schema.json",
  "title": "ATG Business Policy Contract",
  "description": "Local synthetic buyer policy boundaries. This record creates neither human authority nor agent standing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policySchemaVersion", "policyId", "policyVersion", "owningOrganisationId", "policyOwnerReference", "effectiveAt", "expiresAt", "permittedActionTypes", "permittedTools", "permittedOperations", "permittedSupplierIds", "permittedCounterpartyClasses", "permittedRecipientClasses", "permittedDestinationClasses", "permittedSupplierAccountReferenceClasses", "permittedEnvironments", "currency", "individualActionLimits", "humanReviewBands", "prohibitedActionClasses", "customerContactRestrictions", "pricingLimits", "requiredEvidenceTypes", "evidenceFreshnessRules", "requiredAuthorityTier", "separationOfDuties", "riskTierRules", "policyStatus", "revocationReference", "minimumTrustedTime", "localOnly", "syntheticOnly", "createsAuthority", "policyDigest"],
  "properties": {
    "policySchemaVersion": { "const": "atg.business-policy-contract.local.v1" },
    "policyId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "owningOrganisationId": { "type": "string", "minLength": 1 },
    "policyOwnerReference": { "type": "string", "minLength": 1 },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "permittedActionTypes": { "$ref": "#/definitions/stringSet" },
    "permittedTools": { "$ref": "#/definitions/stringSet" },
    "permittedOperations": { "$ref": "#/definitions/stringSet" },
    "permittedSupplierIds": { "$ref": "#/definitions/stringSet" },
    "permittedCounterpartyClasses": { "$ref": "#/definitions/stringSet" },
    "permittedRecipientClasses": { "$ref": "#/definitions/stringSet" },
    "permittedDestinationClasses": { "$ref": "#/definitions/stringSet" },
    "permittedSupplierAccountReferenceClasses": { "$ref": "#/definitions/stringSet" },
    "permittedEnvironments": { "$ref": "#/definitions/stringSet" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "individualActionLimits": { "type": "object" },
    "humanReviewBands": { "type": "array", "minItems": 1 },
    "prohibitedActionClasses": { "$ref": "#/definitions/stringSet" },
    "customerContactRestrictions": { "type": "object" },
    "pricingLimits": { "type": "object" },
    "requiredEvidenceTypes": { "$ref": "#/definitions/stringSet" },
    "evidenceFreshnessRules": { "type": "array", "minItems": 1 },
    "requiredAuthorityTier": { "type": "string", "minLength": 1 },
    "separationOfDuties": { "type": "object" },
    "riskTierRules": { "type": "array", "minItems": 4, "maxItems": 4 },
    "policyStatus": { "enum": ["active", "inactive", "revoked"] },
    "revocationReference": { "type": ["string", "null"] },
    "minimumTrustedTime": { "type": "string", "format": "date-time" },
    "localOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "createsAuthority": { "const": false },
    "policyDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "definitions": {
    "stringSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
