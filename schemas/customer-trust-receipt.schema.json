{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/customer-trust-receipt.schema.json",
  "title": "ATG Customer Trust Receipt",
  "type": "object",
  "required": ["receiptVersion", "receiptId", "runId", "sourceCaseId", "sourceCaseDigest", "atgVerdict", "shadowMode", "gatePassStatus", "syntheticExecutionStatus", "decisionEvidence", "executionEvidence", "evidenceLink", "controlsEvaluated", "evidenceTime", "verificationStatus", "scope", "limitations", "nonAuthorityStatement", "syntheticNonProductionStatement", "authorityGranted", "executable", "reservable", "retryPermitted", "revocationControl", "commercialWisdomProven", "customerApprovalProven", "productionReadinessProven", "regulatoryApprovalProven", "receiptDigest"],
  "properties": {
    "receiptVersion": { "const": "atg.customer-trust-receipt.local.v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sourceCaseId": { "type": "string", "minLength": 1 },
    "sourceCaseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "atgVerdict": { "enum": ["ACCEPT", "REJECT", "REFER", "SHADOW"] },
    "shadowMode": { "type": "object" },
    "gatePassStatus": { "enum": ["NOT_ISSUED", "ISSUED", "CONSUMED", "REVOKED", "EXPIRED", "OTHER_EVIDENCED"] },
    "syntheticExecutionStatus": { "enum": ["ACKNOWLEDGED", "BLOCKED", "NOT_ATTEMPTED"] },
    "decisionEvidence": { "type": "object" },
    "executionEvidence": { "type": "object" },
    "evidenceLink": { "type": "object" },
    "controlsEvaluated": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceTime": { "const": "2026-09-02T09:00:00.000Z" },
    "verificationStatus": { "const": "VERIFIED_LOCAL_SYNTHETIC_EVIDENCE" },
    "scope": { "const": "P3-M161_LOCAL_SYNTHETIC_PURCHASING_DEMONSTRATION" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "nonAuthorityStatement": { "type": "string", "minLength": 1 },
    "syntheticNonProductionStatement": { "type": "string", "minLength": 1 },
    "authorityGranted": { "const": false },
    "executable": { "const": false },
    "reservable": { "const": false },
    "retryPermitted": { "const": false },
    "revocationControl": { "const": false },
    "commercialWisdomProven": { "const": false },
    "customerApprovalProven": { "const": false },
    "productionReadinessProven": { "const": false },
    "regulatoryApprovalProven": { "const": false },
    "receiptDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
