{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gareth1953/agent-trust-gate/schemas/emergency-stop-record.schema.json",
  "title": "ATG Emergency Stop Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion", "recordId", "sequence", "active", "operation", "reason", "actorReference", "authorityEvidenceDigest", "recordedAt", "affectedScope", "reservedOrUnknownReversed", "localOnly", "syntheticOnly", "recordDigest"],
  "properties": {
    "recordVersion": { "const": "atg.emergency-stop-record.local.v1" },
    "recordId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean" },
    "operation": { "enum": ["activate", "deactivate"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "actorReference": { "type": "string", "minLength": 1 },
    "authorityEvidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "affectedScope": { "const": "global_local_gateway" },
    "reservedOrUnknownReversed": { "const": false },
    "localOnly": { "const": true },
    "syntheticOnly": { "const": true },
    "recordDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
